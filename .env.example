# Ivoolve Agent - Docker local
FRONTEND_PORT=5021
BACKEND_PORT=5020
PUBLIC_APP_URL=http://localhost:5021
BACKEND_PUBLIC_URL=http://localhost:5020
# En producción con app + socket en subdominios, usa el dominio padre mínimo.
# Ejemplo: orchestrator.programandoweb.net comparte la cookie con
# socket.orchestrator.programandoweb.net sin exponerla a todo programandoweb.net.
SESSION_COOKIE_DOMAIN=

# MariaDB interna
DB_DATABASE=ivoolve_agent
DB_USERNAME=ivoolve
DB_PASSWORD=ivoolve_local
DB_ROOT_PASSWORD=ivoolve_root_local
DATABASE_POOL_SIZE=10
DATABASE_AUTO_MIGRATE=true
DEFAULT_TENANT_ID=default

# Acceso inicial
ADMIN_USERNAME=admin
# Generar con:
# docker compose run --rm backend npm run auth:hash -- "TuClaveSegura"
ADMIN_PASSWORD_HASH=
# Generar con:
# docker compose run --rm backend npm run auth:secret
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Redis / runtime
SESSION_TTL_SECONDS=86400
RUNTIME_INSTANCE_ID=docker-main
PROVIDER_LEASE_TTL_SECONDS=45
APPROVAL_REQUIRED_TOOLS=provider.send_message

# Google
GOOGLE_MAPS_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Generación local de video vía ivoolve_video_generator_py.
# En Docker Desktop, si el worker corre en este mismo PC:
# VIDEO_GENERATOR_BASE_URL=http://host.docker.internal:8650
# En producción, usar la IP privada/VPN del PC.
VIDEO_GENERATOR_BASE_URL=http://host.docker.internal:8650
VIDEO_GENERATOR_TOKEN=
VIDEO_GENERATOR_TIMEOUT_MS=15000

# LLM OpenAI-compatible.
# En Windows/Mac con LM Studio en el host, host.docker.internal suele ser la ruta adecuada.
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_MODEL=google/gemma-4-e4b
LLM_API_KEY=lm-studio
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=60000

# Provider LM Studio alternativo
LM_STUDIO_BASE_URL=
LM_STUDIO_MODEL=
LM_STUDIO_API_KEY=
LM_STUDIO_TIMEOUT_MS=180000
LM_STUDIO_CHAT_PATH=/api/v1/chat
LM_STUDIO_FALLBACK_CHAT_PATH=/v1/chat/completions

# Observabilidad
METRICS_WINDOW_MINUTES=60
ALERT_FAILURE_RATE=0.2
ALERT_P95_MS=60000

# Integración con IvoolveOps
IVOOLVEOPS_SERVICE_TOKEN=
IVOOLVEOPS_ALLOWED_ORIGIN=
SSO_TICKET_TTL_SECONDS=60

# Integración con Ivoolve SIC
# Token con el que SIC llama este backend.
IVOOLVE_SIC_SERVICE_TOKEN=
# Laravel SIC accesible desde el backend de agentes.
IVOOLVE_SIC_BASE_URL=http://host.docker.internal:8000
# Debe coincidir con SIC_INTERNAL_TOKEN del Laravel SIC.
IVOOLVE_SIC_INTERNAL_TOKEN=
IVOOLVE_SIC_TIMEOUT_MS=15000
