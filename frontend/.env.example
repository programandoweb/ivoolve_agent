# URL pública del frontend. Se usa para canonical, OpenGraph y metadata social.
NEXT_PUBLIC_APP_URL=http://localhost:5021

# URL server-only para endpoints auxiliares HTTP.
BACKEND_URL=http://localhost:5020

# Socket.IO sí necesita una URL pública porque la conexión la abre el navegador.
NEXT_PUBLIC_SOCKET_URL=http://localhost:5020
