PORT=5020

# Redis: sesiones, idempotencia, leases distribuidos y BullMQ.
REDIS_URL=redis://localhost:6379
SESSION_TTL_SECONDS=86400

# MariaDB compartida. Si se omite DATABASE_URL, desarrollo conserva fallback local.
DATABASE_URL=mysql://ivoolve:ivoolve@localhost:3307/ivoolve_agent
DATABASE_POOL_SIZE=10
DATABASE_AUTO_MIGRATE=true
DEFAULT_TENANT_ID=default

# Agentes core versionados y agentes gestionados creados desde UI.
AGENTS_PATH=agents
AGENTS_MANAGED_PATH=data/managed-agents

# Providers: credenciales Baileys siguen en almacenamiento persistente.
PROVIDERS_DATA_PATH=data/providers
RUNTIME_INSTANCE_ID=
PROVIDER_LEASE_TTL_SECONDS=45

# Fallbacks locales cuando MariaDB no está habilitada.
RUNTIME_DATA_PATH=data/runtime
APPROVALS_DATA_PATH=data/runtime/approvals.json
AUDIT_DATA_PATH=data/runtime/audit.jsonl

# Tools que requieren decisión humana antes de ejecutarse.
APPROVAL_REQUIRED_TOOLS=provider.send_message

# Google para prospección comercial de Ivoolve ERP.
# Maps/Places es la fuente primaria. Search es opcional para enriquecimiento.
GOOGLE_MAPS_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Worker local de generación de video (Windows + Intel XPU).
# Recomendado: IP privada/VPN del PC que ejecuta ivoolve_video_generator_py.
VIDEO_GENERATOR_BASE_URL=http://10.8.0.2:8650
VIDEO_GENERATOR_TOKEN=
VIDEO_GENERATOR_TIMEOUT_MS=15000

# Ventana y umbrales de alertas operativas.
METRICS_WINDOW_MINUTES=60
ALERT_FAILURE_RATE=0.2
ALERT_P95_MS=60000

# LM Studio / API OpenAI-compatible.
LLM_BASE_URL=http://10.8.0.2:1234/v1
LLM_MODEL=google/gemma-4-e4b
LLM_API_KEY=lm-studio
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=60000

LM_STUDIO_BASE_URL=https://lmstudio.migo.expert
LM_STUDIO_MODEL=google/gemma-4-e4b
LM_STUDIO_API_KEY=TU_API_KEY
LM_STUDIO_TIMEOUT_MS=180000
LM_STUDIO_CHAT_PATH=/api/v1/chat
LM_STUDIO_FALLBACK_CHAT_PATH=/v1/chat/completions

# Bootstrap inicial. Al habilitar DB se crea/asegura este admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=EL_HASH_GENERADO
JWT_SECRET=EL_SECRETO_GENERADO
JWT_EXPIRES_IN=8h

# Integración service-to-service con IvoolveOps.
# Debe coincidir con IVOOLVE_AGENT_SERVICE_TOKEN en IvoolveOps.
IVOOLVEOPS_SERVICE_TOKEN=
IVOOLVEOPS_ALLOWED_ORIGIN=
SSO_TICKET_TTL_SECONDS=60
PUBLIC_APP_URL=http://localhost:5021
