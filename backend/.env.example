PORT=5020

# Redis mantiene sesiones y también es backend de BullMQ.
REDIS_URL=redis://localhost:6379
SESSION_TTL_SECONDS=86400

# Carpeta declarativa de agentes.
AGENTS_PATH=agents

# Origen autorizado del frontend para Socket.IO.
FRONTEND_ORIGIN=http://localhost:5021

# Seguridad del dashboard.
# Genera el hash con: npm run auth:hash -- "TuClaveSegura"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
JWT_SECRET=
JWT_EXPIRES_IN=8h

# LM Studio suele exponer una API compatible con OpenAI en este endpoint.
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=local-model
LLM_API_KEY=lm-studio
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=60000
