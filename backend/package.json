{
  "name": "ivoolve-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo didáctico multiagente con NestJS, Redis, Socket.IO y BullMQ",
  "workspaces": ["apps/*"],
  "scripts": {
    "build": "nest build orchestrator",
    "start": "node dist/apps/orchestrator/main.js",
    "start:dev": "nest start orchestrator --watch",
    "start:debug": "nest start orchestrator --debug --watch",
    "test": "jest",
    "redis:up": "docker compose up -d redis",
    "redis:down": "docker compose down",
    "auth:hash": "node scripts/hash-password.mjs",
    "auth:secret": "node scripts/generate-jwt-secret.mjs",
    "setup:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/setup.ps1"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "@whiskeysockets/baileys": "6.7.24",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "ioredis": "^5.4.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
