{
  "manifest_version": 3,
  "name": "Ivoolve Argos · Prospecting",
  "short_name": "Argos",
  "version": "1.1.0",
  "minimum_chrome_version": "116",
  "description": "Argos, investigador comercial visual: panel lateral derecho con configuración Socket.IO, conexión, actividad y recolección de fichas públicas visibles en Google Maps.",
  "permissions": [
    "tabs",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://www.google.com/maps/*",
    "https://www.google.com.co/maps/*",
    "https://maps.google.com/*",
    "http://localhost:5020/*",
    "https://*.programandoweb.net/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Argos · Prospecting",
    "default_icon": {
      "16": "dist/icon-16.png",
      "32": "dist/icon-32.png",
      "48": "dist/icon-48.png"
    }
  },
  "icons": {
    "16": "dist/icon-16.png",
    "32": "dist/icon-32.png",
    "48": "dist/icon-48.png",
    "128": "dist/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://www.google.com.co/maps/*",
        "https://maps.google.com/*"
      ],
      "js": [
        "dist/maps.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
